#----------- Sinhala touching reph combinations  ------------
# Push the Reph the middle when touching two consonants with Reph
@REPH_REPLACEMENT_1 = [sinKa.reph sinGa.reph sinNna.reph sinTa.reph sinBha.reph sinYa.reph sinDa.reph];
@REPH_REPLACEMENT_2 = [sinKha.reph sinGha.reph sinCa.reph sinTta.reph sinDda.reph sinDha.reph sinMa.reph sinVa.reph sinPa.reph sinSa.reph sinBa.reph sinLa.reph sinDa.reph sinJha.reph];
lookup touch_reph_decompose {
    sub sinKa.reph by sinKa sinReph.001;
    sub sinJha.reph by sinJha sinReph.001;
    sub sinGha.reph by sinGha sinReph.001;
    sub sinTa.reph by sinTa sinReph.001;
    sub sinBha.reph by sinBha sinReph.001;
    sub sinGa.reph by sinGa sinReph.002;
    sub sinKha.reph by sinKha sinReph.002;
    sub sinCa.reph by sinCa sinReph.002;
    sub sinTta.reph by sinTta sinReph.002;
    sub sinDda.reph by sinDda sinReph.002;
    sub sinMa.reph by sinMa sinReph.002;
    sub sinVa.reph by sinVa sinReph.002;
    sub sinDha.reph by sinDha sinReph.002;
    sub sinBa.reph by sinBa sinReph.002;
    sub sinPa.reph by sinPa sinReph.005;
    sub sinLa.reph by sinLa sinReph.005;
    sub sinYa.reph by sinYa sinReph.005;
    sub sinDa.reph by sinDa sinReph.009;
    sub sinNna.reph by sinNna sinReph.010;
} touch_reph_decompose;

lookup touch_reph {
    sub sinTouch @REPH_REPLACEMENT_1' lookup touch_reph_decompose;
    sub sinTouch @REPH_REPLACEMENT_2' lookup touch_reph_decompose;
} touch_reph;

#----------- Sinhala touching reph with MatraI /Ii  ------------
# Push the Reph to on top of the first consonant in a touching ligature when the second consonat is combined with -i and -ii
@BASE_ASCENDING = [sinKha sinNga sinNnga sinCa sinJha sinTta sinTtha sinDda sinDdha sinNndda sinTha sinDha sinPha sinBa sinMa sinMba sinVa];
@BASE_BODY_HEIGHT = [sinKa sinGa sinGha sinCha sinJa sinNya sinJnya sinNyja sinNna sinTa sinNa sinPa sinBha sinYa sinLa sinSha sinSsa sinSa sinHa sinLla sinFa];
@BASE_NARROW = [sinDa sinNda];
@REPH_REPLACEMENT_MATRAI_1 = [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinTthI sinDdI sinDdhI sinNnI sinNnddI sinTI sinThI sinDI sinDhI sinNI sinNdI sinPI sinPhI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinTThI sinNDI sinNDhI sinNVI sinNThI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI];
@REPH_REPLACEMENT_MATRAIi_1 = [sinKIi sinKhIi sinGIi sinGhIi sinNgIi sinNngIi sinCIi sinChIi sinJIi sinJhIi sinNyIi sinJnyIi sinNyjIi sinTtIi sinTthIi sinDdIi sinDdhIi sinNnIi sinNnddIi sinTIi sinThIi sinDIi sinDhIi sinNIi sinNdIi sinPIi sinPhIi sinBIi sinBhIi sinMIi sinMbIi sinYIi sinRIi sinLIi sinVIi sinShIi sinSsIi sinSIi sinHIi sinLlIi sinFIi sinKSsIi sinKVIi sinTVIi sinTThIi sinNDIi sinNDhIi sinNVIi sinNThIi sinGDhIi sinDVIi sinDDhIi sinTtTthIi sinNyCIi sinNyChIi sinCCIi sinBBIi];
lookup touch_reph_matraI {
    sub @BASE_ASCENDING sinTouch [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinTthI sinDdI sinDdhI sinNnI sinNnddI sinTI sinThI sinDI sinDhI sinNI sinNdI sinPI sinPhI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinTThI sinNDI sinNDhI sinNVI sinNThI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI] sinReph' by sinReph.003;
    sub @BASE_ASCENDING sinTouch [sinKIi sinKhIi sinGIi sinGhIi sinNgIi sinNngIi sinCIi sinChIi sinJIi sinJhIi sinNyIi sinJnyIi sinNyjIi sinTtIi sinTthIi sinDdIi sinDdhIi sinNnIi sinNnddIi sinTIi sinThIi sinDIi sinDhIi sinNIi sinNdIi sinPIi sinPhIi sinBIi sinBhIi sinMIi sinMbIi sinYIi sinRIi sinLIi sinVIi sinShIi sinSsIi sinSIi sinHIi sinLlIi sinFIi sinKSsIi sinKVIi sinTVIi sinTThIi sinNDIi sinNDhIi sinNVIi sinNThIi sinGDhIi sinDVIi sinDDhIi sinTtTthIi sinNyCIi sinNyChIi sinCCIi sinBBIi] sinReph' by sinReph.003;
    sub @BASE_NARROW sinTouch [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinTthI sinDdI sinDdhI sinNnI sinNnddI sinTI sinThI sinDI sinDhI sinNI sinNdI sinPI sinPhI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinTThI sinNDI sinNDhI sinNVI sinNThI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI] sinReph' by sinReph.005;
    sub @BASE_NARROW sinTouch [sinKIi sinKhIi sinGIi sinGhIi sinNgIi sinNngIi sinCIi sinChIi sinJIi sinJhIi sinNyIi sinJnyIi sinNyjIi sinTtIi sinTthIi sinDdIi sinDdhIi sinNnIi sinNnddIi sinTIi sinThIi sinDIi sinDhIi sinNIi sinNdIi sinPIi sinPhIi sinBIi sinBhIi sinMIi sinMbIi sinYIi sinRIi sinLIi sinVIi sinShIi sinSsIi sinSIi sinHIi sinLlIi sinFIi sinKSsIi sinKVIi sinTVIi sinTThIi sinNDIi sinNDhIi sinNVIi sinNThIi sinGDhIi sinDVIi sinDDhIi sinTtTthIi sinNyCIi sinNyChIi sinCCIi sinBBIi] sinReph' by sinReph.005;
    sub @BASE_BODY_HEIGHT sinTouch [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinTthI sinDdI sinDdhI sinNnI sinNnddI sinTI sinThI sinDI sinDhI sinNI sinNdI sinPI sinPhI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinTThI sinNDI sinNDhI sinNVI sinNThI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI] sinReph' by sinReph.004;
    sub @BASE_BODY_HEIGHT sinTouch [sinKIi sinKhIi sinGIi sinGhIi sinNgIi sinNngIi sinCIi sinChIi sinJIi sinJhIi sinNyIi sinJnyIi sinNyjIi sinTtIi sinTthIi sinDdIi sinDdhIi sinNnIi sinNnddIi sinTIi sinThIi sinDIi sinDhIi sinNIi sinNdIi sinPIi sinPhIi sinBIi sinBhIi sinMIi sinMbIi sinYIi sinRIi sinLIi sinVIi sinShIi sinSsIi sinSIi sinHIi sinLlIi sinFIi sinKSsIi sinKVIi sinTVIi sinTThIi sinNDIi sinNDhIi sinNVIi sinNThIi sinGDhIi sinDVIi sinDDhIi sinTtTthIi sinNyCIi sinNyChIi sinCCIi sinBBIi] sinReph' by sinReph.004;
    sub @BASE_NARROW sinTouch [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinTthI sinDdI sinDdhI sinNnI sinNnddI sinTI sinThI sinDI sinDhI sinNI sinNdI sinPI sinPhI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinTThI sinNDI sinNDhI sinNVI sinNThI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI] sinReph' by sinReph.005;
} touch_reph_matraI;

#----------- Sinhala MatraI and MatraII Reph combinations  ------------
# Place the Reph inside the MatraI and MatraII
@MATRAI_1 = [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinDdI sinNnddI sinTI sinDI sinDhI sinNI sinNdI sinPI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinNDI sinNDhI sinNVI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI sinKIi sinKhIi sinGIi sinGhIi sinNgIi sinNngIi sinCIi sinChIi sinJIi sinJhIi sinNyIi sinJnyIi sinNyjIi sinTtIi sinDdIi sinNnIi sinNnddIi sinTIi sinDIi sinDhIi sinNIi sinNdIi sinPIi sinBIi sinBhIi sinMIi sinMbIi sinYIi sinRIi sinLIi sinVIi sinShIi sinSsIi sinSIi sinHIi sinLlIi sinFIi sinKSsIi sinKVIi sinTVIi sinNDIi sinNDhIi sinNVIi sinGDhIi sinDVIi sinDDhIi sinNyCIi sinNyChIi sinCCIi sinBBIi];
@MATRAI_2 = [sinTthI sinDdhI sinThI sinPhI sinTThI sinNThI sinTthIi sinDdhIi sinThIi sinPhIi sinTThIi sinNThIi];
@MATRAI_3 = [sinNnI sinNnIi];
lookup matraI_matraII_reph {
    sub [sinKI sinKhI sinGI sinGhI sinNgI sinNngI sinCI sinChI sinJI sinJhI sinNyI sinJnyI sinNyjI sinTtI sinDdI sinNnddI sinTI sinDI sinDhI sinNI sinNdI sinPI sinBI sinBhI sinMI sinMbI sinYI sinRI sinLI sinVI sinShI sinSsI sinSI sinHI sinLlI sinFI sinKSsI sinKVI sinTVI sinNDI sinNDhI sinNVI sinGDhI sinDVI sinDDhI sinTtTthI sinNyCI sinNyChI sinCCI sinBBI sinKIi sinKhIi sinGIi sinGhIi sinNgIi sinNngIi sinCIi sinChIi sinJIi sinJhIi sinNyIi sinJnyIi sinNyjIi sinTtIi sinDdIi sinNnIi sinNnddIi sinTIi sinDIi sinDhIi sinNIi sinNdIi sinPIi sinBIi sinBhIi sinMIi sinMbIi sinYIi sinRIi sinLIi sinVIi sinShIi sinSsIi sinSIi sinHIi sinLlIi sinFIi sinKSsIi sinKVIi sinTVIi sinNDIi sinNDhIi sinNVIi sinGDhIi sinDVIi sinDDhIi sinNyCIi sinNyChIi sinCCIi sinBBIi] sinReph' by sinReph.006;
    sub @MATRAI_2 sinReph' by sinReph.007;
    sub @MATRAI_3 sinReph' by sinReph.008;
} matraI_matraII_reph;

#----------- Sinhala Candrabindu placement  ------------
# Place the Reph inside the MatraI and MatraII
lookup sinCandrabindu {
    sub @BASE_BODY_HEIGHT sinCandrabindu' by sinCandrabindu.001;
} sinCandrabindu;

