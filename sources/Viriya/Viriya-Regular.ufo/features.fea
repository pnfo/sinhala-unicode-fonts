feature akhn {
    script sinh;
    lookup sinakhands;
    lookup sinakhands_reph;
    lookup sin_touch;
} akhn;

feature rphf {
    script sinh;
    lookup sinreph;
} rphf;

feature vatu {
    script sinh;
    lookup sin_vatu;
    lookup sinrakaar;
} vatu;

feature pstf {
    script sinh;
    lookup si_split_matra;
} pstf;

feature rlig {
    script sinh;
    lookup touch_reph;
    lookup touch_reph_matraI;
    lookup matraI_matraII_reph;
    lookup sinCandrabindu;
} rlig;

feature abvs {
    script sinh;
    lookup sin_virama;
    lookup sinabvs_1;
    lookup sinabvs_2;
    lookup sinabvs_3;
    lookup sinakhands_reph;
} abvs;

feature blws {
    script sinh;
    lookup sinblws_1;
    lookup sinblws_2;
    lookup sinblws_3;
} blws;

feature psts {
    script sinh;
    lookup sin_psts;
    lookup sin_da_subscripts;
    lookup jnya_u_reph {
        sub sinJnya.reph sinMatraU by sinJnyU.reph;
        sub sinJnya.reph sinMatraUu by sinJnyUu.reph;
    } jnya_u_reph;

    lookup rakar_u_short {
        sub sinRakar sinMatraU' by sinMatraU.sub;
        sub sinRakar sinMatraUu' by sinMatraUu.sub;
    } rakar_u_short;

} psts;

feature akhn {
    script sinh;
    lookup legacy_bandi;
} akhn;

lookup legacy_parity {
    sub sinMatraE sinNya sinMatraAa.virama by leg.MatraE_Nya_MatraAa.virama;
    sub sinMatraE sinJnya sinMatraAa.virama by leg.MatraE_Jnya_MatraAa.virama;
    sub sinMatraE sinDa sinMatraAa.virama by leg.MatraE_Da_MatraAa.virama;
    sub sinMatraE sinNda sinMatraAa.virama by leg.MatraE_Nda_MatraAa.virama;
    sub sinMatraE sinNDa sinMatraAa.virama by leg.MatraE_NDa_MatraAa.virama;
    sub sinMatraE sinNga sinRakar sinVirama by leg.MatraE_Nga_Rakar_Virama;
    sub sinNnga sinRakar by leg.Nnga_Rakar;
    sub sinCha sinRakar sinMatraI by leg.Cha_Rakar_MatraI;
    sub sinCha sinRakar sinMatraIi by leg.Cha_Rakar_MatraIi;
    sub sinMatraE sinCha sinRakar sinVirama by leg.MatraE_Cha_Rakar_Virama;
    sub sinTtha sinRakar sinMatraI by leg.Ttha_Rakar_MatraI;
    sub sinTtha sinRakar sinMatraIi by leg.Ttha_Rakar_MatraIi;
    sub sinDdha sinRakar sinMatraI by leg.Ddha_Rakar_MatraI;
    sub sinDdha sinRakar sinMatraIi by leg.Ddha_Rakar_MatraIi;
    sub sinNna sinRakar by leg.Nna_Rakar;
    sub sinNna sinRakar sinMatraI by leg.Nna_Rakar_MatraI;
    sub sinNna sinRakar sinMatraIi by leg.Nna_Rakar_MatraIi;
    sub sinTha sinRakar sinMatraI by leg.Tha_Rakar_MatraI;
    sub sinTha sinRakar sinMatraIi by leg.Tha_Rakar_MatraIi;
    sub sinNa sinRakar by leg.Na_Rakar;
    sub sinNa sinRakar sinMatraI by leg.Na_Rakar_MatraI;
    sub sinNa sinRakar sinMatraIi by leg.Na_Rakar_MatraIi;
    sub sinNda sinRakar by leg.Nda_Rakar;
    sub sinNda sinRakar sinMatraI by leg.Nda_Rakar_MatraI;
    sub sinNda sinRakar sinMatraIi by leg.Nda_Rakar_MatraIi;
    sub sinPha sinRakar sinMatraI by leg.Pha_Rakar_MatraI;
    sub sinPha sinRakar sinMatraIi by leg.Pha_Rakar_MatraIi;
    sub sinMba sinRakar sinMatraI by leg.Mba_Rakar_MatraI;
    sub sinMba sinRakar sinMatraIi by leg.Mba_Rakar_MatraIi;
    sub sinMatraE sinMba sinRakar sinVirama by leg.MatraE_Mba_Rakar_Virama;
